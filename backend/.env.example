# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/football_tracker?schema=public"

# JWT
JWT_SECRET="a-long-random-secret"
JWT_EXPIRES_IN="7d"

# football-data.org API token (https://www.football-data.org/client/register)
FOOTBALL_DATA_KEY="your_football_data_org_token"

# API-Football on RapidAPI (https://rapidapi.com/api-sports/api/api-football) — used
# only for match lineups/events/statistics and player stats (football-data.org lacks these).
APIFOOTBALL_KEY="your_rapidapi_key"
APIFOOTBALL_HOST="api-football-v1.p.rapidapi.com"

# Server
PORT=4000

# CORS: the frontend origin allowed to call this API
CLIENT_ORIGIN="http://localhost:5173"

# Required in production — enables secure cookies and locks CORS to CLIENT_ORIGIN.
# Leave unset (defaults to "development") for local dev.
NODE_ENV="development"

# Optional. When set, the upstream-response cache uses Redis instead of an
# in-memory Map, so it survives cold starts and is shared across instances.
# Required for any host that can spin up >1 instance or restarts frequently
# (e.g. Render/Railway/Fly free tiers). Leave unset for local dev.
# REDIS_URL="rediss://default:password@host:6379"
